# Redis (BullMQ + cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/techstack_db

# Proxy (Bright Data / Oxylabs)
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Scraping config
CONCURRENCY_LIMIT=5
REQUEST_DELAY_MS=2000
MAX_RETRIES=3
USER_AGENT=Mozilla/5.0 (compatible; TechStackBot/1.0)

# Storage
S3_BUCKET=techstack-raw-html
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
